{
  "name": "cascade",
  "productName": "Cascade",
  "version": "0.1.0",
  "description": "DOM-powered video editor",
  "type": "module",
  "main": "out/main/index.js",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "setup:whisper": "node scripts/setup-whisper.mjs",
    "dist:linux": "(test -x resources/whisper/linux-x64/whisper-cli || node scripts/setup-whisper.mjs) && electron-vite build && electron-builder --linux"
  },
  "trustedDependencies": ["electron", "electron-winstaller", "esbuild", "ffmpeg-static"],
  "dependencies": {
    "@fontsource-variable/commissioner": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "immer": "^11.1.21",
    "lucide": "^1.60.0",
    "mediabunny": "^1.61.6",
    "sherpa-onnx-node": "1.13.8",
    "solid-js": "^1.9.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
