{
  "name": "cascade",
  "productName": "Cascade",
  "author": "Milenium",
  "homepage": "https://github.com/MileniumHQ/Cascade",
  "desktopName": "cascade.desktop",
  "version": "0.1.1",
  "description": "DOM-powered video editor",
  "type": "module",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "setup:whisper": "node scripts/setup-whisper.mjs",
    "dist:win": "node scripts/dist-win.mjs",
    "flatpak": "node scripts/flatpak.mjs",
    "release": "node scripts/release.mjs",
    "dist:linux": "(test -x resources/whisper/linux-x64/whisper-cli -a -x resources/whisper/linux-x64/cascade-align || node scripts/setup-whisper.mjs) && electron-vite build && electron-builder --linux"
  },
  "trustedDependencies": ["electron", "electron-winstaller", "esbuild", "ffmpeg-static"],
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.94.0",
    "@agentclientprotocol/codex-acp": "^2.2.2",
    "@agentclientprotocol/sdk": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "immer": "^11.1.21",
    "mediabunny": "^1.61.6",
    "sherpa-onnx-node": "1.13.8",
    "solid-js": "^1.9.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@material-symbols/svg-300": "^0.48.0",
    "@types/node": "^26.6.5",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  }
}
